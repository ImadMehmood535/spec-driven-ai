# Server
PORT=3000

# Database — must match docker-compose.yml
DB_HOST=localhost
DB_PORT=5440
DB_USER=postgres
DB_PASS=postgres
DB_NAME=developer_user

# Authentication — set a real secret per environment, never commit one
# The app refuses to boot when JWT_SECRET is missing (see authentication-login)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Seed administrator — consumed by the seeders, never defaulted
# The seed fails loudly when these are absent (see seed-bootstrap)
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
